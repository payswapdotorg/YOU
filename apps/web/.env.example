# Local development stand-ins (docs/DEPLOYMENT.md "local" environment).
# SQLite stand-in for Neon PostgreSQL. Prisma resolves file: URLs relative to
# prisma/schema.prisma, so this points at apps/web/db/custom.db.
#
# ─── NESTED-LAYOUT WARNING (F-06, W4.A) ──────────────────────────────────────
# apps/web is NESTED inside the monorepo, and bun / the Prisma CLI resolve
# .env files relative to the CURRENT WORKING DIRECTORY (walking up parent
# directories): an OUTER .env (e.g. a repo-root or station-level one) WINS
# over this file whenever a command is launched from above apps/web/.
# Symptom: prisma/next happily boot against a DIFFERENT (or missing) SQLite
# file than the one you pushed, depending on where you started the command.
# Live example seen in the wild: running `bun run db:push` from a station
# whose outer .env sets DATABASE_URL=file:/station/db/custom.db silently
# targets the station database instead of apps/web/db/custom.db.
#
# Recommended robust form — an ABSOLUTE path, immune to both the cwd and the
# outer-env-wins behavior (ambient env vars exported by the station still
# override .env files by design; that is the documented station pattern):
#   DATABASE_URL="file:/ABSOLUTE/PATH/TO/YOU/apps/web/db/custom.db"
#
# The relative form below is kept for the documented local-dev flow run from
# apps/web/ itself (bun install && cp .env.example .env && bun run db:push).
DATABASE_URL="file:../db/custom.db"

# HMAC secret for the local object-store adapter's signed URLs.
# Generate a real one for anything beyond local development.
YOU_STORAGE_SECRET="dev-change-me"

# Object-store backend (src/lib/you/core/storage.ts seam):
#   "fs" (default) — bytes under apps/web/db/you-objects/ (local dev only;
#                    the FS is NOT writable on serverless — Vercel lambdas
#                    fail with ENOENT mkdir '/var/task/db', verified live
#                    during the F9 checklist 2026-10-01).
#   "db"            — bytes as content-addressed YouObject rows in the app
#                    database (serverless-viable hosted dev-tier stand-in;
#                    works on SQLite locally AND PostgreSQL/Neon hosted).
# The production target remains Cloudflare R2 behind the same seam.
YOU_STORAGE_BACKEND="fs"

# Recon vision provider (P6.C1): local (default — in-sandbox z-ai SDK) or
# openrouter (hosted vision, production — vlm-recon-or-1)
# YOU_RECON_PROVIDER="local"
# OPENROUTER_API_KEY=""
# YOU_RECON_MODEL="google/gemini-2.5-flash"
# YOU_RECON_TIMEOUT_MS="30000"
# YOU_RECON_BASE_URL="https://openrouter.ai/api/v1"

# AI provider/model registry (P6.C5) — optional knobs layered on the C1 seam.
# All values are validated LENIENTLY: malformed or unknown entries are logged
# once with a documented reason and SKIPPED (boot never crashes); model
# resolution itself is fail-closed (unknown provider / no enabled
# capability-matching model / missing OPENROUTER_API_KEY all throw at
# resolution time). Registry + precedence live in
# src/lib/you/ai/registry.ts; model ids must exist in the registry.
# Precedence per provider for the vision capability:
#   1. YOU_AI_PROVIDERS pin for the selected provider
#   2. YOU_AI_VISION_MODEL (a registry model id of that provider)
#   3. YOU_RECON_MODEL (legacy C1 knob, openrouter passthrough)
#   4. registry healthy default (zai → glm-5v-turbo,
#      openrouter → google/gemini-2.5-flash)
# Default vision model (single registry model id):
# YOU_AI_VISION_MODEL="google/gemini-2.5-flash"
# Per-provider model pins, comma-separated "provider:model" pairs:
# YOU_AI_PROVIDERS="openrouter:google/gemini-2.5-flash,zai:glm-5v-turbo"
# r2 backend (P6.A1 production target) — all four required when backend=r2:
# YOU_R2_ACCOUNT_ID=""
# YOU_R2_ACCESS_KEY_ID=""
# YOU_R2_SECRET_ACCESS_KEY=""
# YOU_R2_BUCKET=""
# YOU_R2_ENDPOINT=""  # optional; default https://<account>.r2.cloudflarestorage.com

# ─── Render provider (P6.C2) ────────────────────────────────────────────────
# WHO renders image/video artifacts. Fail-closed on unknown values (the C1
# YOU_RECON_PROVIDER law, render side): station (default — in-sandbox z-ai
# SDK, unchanged behavior; "local" and "zai" are accepted aliases, the same
# naming as the recon seam) or dashscope (hosted rendering via the DashScope /
# Alibaba Bailian HTTP APIs — ai/dashscope.ts, plain fetch, no SDK).
# YOU_RENDER_PROVIDER="station"
#
# DashScope hosted render path (required at USE time when provider=dashscope;
# a render job with no key fails with a precise error — never a guess):
# DASHSCOPE_API_KEY=""
#
# Model ids — seam-level defaults for direct seam calls. The RENDER path
# resolves models through the registry (ai/registry.ts 'image-gen' /
# 'video-gen' capabilities); documented precedence:
#   1. YOU_AI_PROVIDERS pin (e.g. "dashscope:wanx2.1-t2i-turbo")
#   2. the seam-level knob below
#   3. registry healthy default (must equal these defaults — test-asserted)
# YOU_DASHSCOPE_IMAGE_MODEL="wanx2.1-t2i-turbo"
# YOU_DASHSCOPE_VIDEO_MODEL="wan2.2-t2v-plus"
# API base (default: the international endpoint; CN mainland deployments use
# https://dashscope.aliyuncs.com):
# YOU_DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com"
# Per-HTTP-call timeout, poll cadence and task-wait deadlines (bounded-poll
# law: polls stop at the deadline AND a derived max-attempt count):
# YOU_DASHSCOPE_TIMEOUT_MS="30000"
# YOU_DASHSCOPE_POLL_INTERVAL_MS="5000"
# YOU_DASHSCOPE_IMAGE_MAX_WAIT_MS="300000"
# YOU_DASHSCOPE_VIDEO_MAX_WAIT_MS="600000"

# ─── Resilience (P6.A6-FULL) ────────────────────────────────────────────────
# All knobs are optional with SAFE defaults (fail-closed: invalid values fall
# back to the defaults, never to "retry forever"). Every retry loop is bounded
# by BOTH a max-attempt count and a wall-clock budget.
#
# Shared provider-call retry engine (ai/zai.ts + ai/openrouter.ts):
# YOU_RETRY_MAX_ATTEMPTS="3"        # total attempts per provider call
# YOU_RETRY_BASE_DELAY_MS="500"     # first backoff delay (exponential + jitter)
# YOU_RETRY_MAX_DELAY_MS="8000"     # delay ceiling — also caps Retry-After
# YOU_RETRY_BUDGET_MS="30000"       # wall-clock budget per call sequence
#
# Durable-job retries (core/jobs.ts — a job that exhausts its budget goes to
# the terminal `dead` state; see GET /api/v1/maintenance/dead-jobs):
# YOU_JOB_MAX_ATTEMPTS="3"
# YOU_JOB_RETRY_BASE_DELAY_MS="500"
# YOU_JOB_RETRY_BUDGET_MS="30000"
#
# Outbound webhook delivery retries (core/events.ts):
# YOU_WEBHOOK_RETRY_MAX_ATTEMPTS="3"
#
# Per-provider circuit breaker (core/circuit-breaker.ts — zai / openrouter /
# dashscope; open state fails fast with a typed error; routes answer honest 503s):
# YOU_BREAKER_ENABLED="1"             # "0" disables the breaker (passthrough)
# YOU_BREAKER_FAILURE_THRESHOLD="5"   # failures in window to open
# YOU_BREAKER_WINDOW_MS="60000"       # rolling failure window
# YOU_BREAKER_COOLDOWN_MS="30000"     # open -> half-open probe wait
#
# Dead-job retention (operator purge via POST /api/v1/maintenance/dead-jobs
# {"action":"purge"}; default 30 days from finishedAt):
# YOU_DEAD_JOB_RETENTION_DAYS="30"
#
# Evidence-request expiry (P6.B5): open requests older than this many days are
# expired by POST /api/v1/maintenance/expire-evidence-requests (operator sweep;
# requests with an ACTIVE fulfillment capture are skipped, never expired
# mid-flight; default 30 days from createdAt):
# YOU_EVIDENCE_REQUEST_TTL_DAYS="30"

# ─── Compute broker (P6.C3) ──────────────────────────────────────────────────
# The broker's routed submission surface (render.image / render.video through
# POST /api/v1/renders). Both knobs are BOOT-TOLERANT: malformed values fall
# back to the documented SAFE defaults — boot never crashes, and a bad config
# can never accidentally route tenant data to a hosted provider.
#
# Ordered provider enable list (routing = first enabled provider that can
# serve the workload/adapter; comma-separated, case/whitespace tolerant;
# unknown/duplicate tokens are logged once and skipped):
#   local-executor  (alias: local)      — in-process durable job runner
#                                         (station SDK + deterministic
#                                         renderers; serves ALL workloads)
#   dashscope-render (alias: dashscope) — the hosted DashScope render path
#                                         (P6.C2 seam, broker-routed since
#                                         P6.C3; render.image/render.video
#                                         with the ai-image-1/ai-video-1
#                                         provider adapters ONLY — the
#                                         deterministic svg-portrait-1
#                                         renderer never routes hosted;
#                                         requires DASHSCOPE_API_KEY)
# Routing honesty: privacy "local-only"/"no-provider-egress" requests never
# route hosted; failover only ever NARROWS privacy (hosted → local when the
# hosted breaker is open), never widens it; per-job broker routing overrides
# YOU_RENDER_PROVIDER for the jobs it routes (routed hosted jobs run hosted
# even when the env seam says station — proven by the C3 e2e suite).
# Default (also the fallback for empty/invalid values): local-executor only.
# YOU_COMPUTE_PROVIDERS="local-executor"
#
# Per-tenant quoted-cost ceiling (fail-closed cost guard at broker submit):
# the sum of QUOTED (modeled-basis) costs of the tenant's broker-submitted
# jobs in the rolling 24h window plus the new quote must stay <= this ceiling,
# or the submit is refused with a 402 compute_quota_exceeded envelope (every
# refusal counted in /api/v1/metrics as compute_quota_refusals{workload}).
# The window spend is a conservative upper bound (failed/dead/cancelled
# broker submits included; the 500 most recent rows are counted). Garbage,
# negative or empty values fall back to the default; "0" is a VALID operator
# choice (blocks all paid work — zero-cost deterministic renders still pass).
# YOU_COMPUTE_TENANT_MAX_COST_USD="50"

# ─── Live sessions (P6.C7 — realtime performance / WebRTC path) ─────────────
# HMAC secret for live-session signaling tokens (the short-lived capability
# tokens minted at live-session create). PLACEHOLDER ONLY — generate a real
# secret for any deployed environment. When unset, the runtime derives a
# PER-PROCESS random key: honest dev-tier behavior (a restart invalidates
# outstanding tokens; the API says so verbatim instead of failing silently).
YOU_LIVE_SIGNALING_SECRET=""

# ─── API playground sandbox mode (P6.B9) ────────────────────────────────────
# The Develop → Playground EXECUTE action runs LIVE against the real API
# with your session by default. Setting this to "1" routes playground
# executes through the DETERMINISTIC FIXTURES SEAM when one is present in
# the deployment; with no fixtures seam registered, the playground reports
# the honest "sandbox unavailable" state — it NEVER fabricates responses.
# Any other value (including garbage) fails closed to live execution.
# YOU_PLAYGROUND_SANDBOX="0"
