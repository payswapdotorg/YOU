# Local development stand-ins (docs/DEPLOYMENT.md "local" environment).
# SQLite stand-in for Neon PostgreSQL. Prisma resolves file: URLs relative to
# prisma/schema.prisma, so this points at apps/web/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# HMAC secret for the local object-store adapter's signed URLs.
# Generate a real one for anything beyond local development.
YOU_STORAGE_SECRET="dev-change-me"
