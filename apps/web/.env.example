# Local development stand-ins (docs/DEPLOYMENT.md "local" environment).
# SQLite stand-in for Neon PostgreSQL. Prisma resolves file: URLs relative to
# prisma/schema.prisma, so this points at apps/web/db/custom.db.
#
# ─── NESTED-LAYOUT WARNING (F-06, W4.A) ──────────────────────────────────────
# apps/web is NESTED inside the monorepo, and bun / the Prisma CLI resolve
# .env files relative to the CURRENT WORKING DIRECTORY (walking up parent
# directories): an OUTER .env (e.g. a repo-root or station-level one) WINS
# over this file whenever a command is launched from above apps/web/.
# Symptom: prisma/next happily boot against a DIFFERENT (or missing) SQLite
# file than the one you pushed, depending on where you started the command.
# Live example seen in the wild: running `bun run db:push` from a station
# whose outer .env sets DATABASE_URL=file:/station/db/custom.db silently
# targets the station database instead of apps/web/db/custom.db.
#
# Recommended robust form — an ABSOLUTE path, immune to both the cwd and the
# outer-env-wins behavior (ambient env vars exported by the station still
# override .env files by design; that is the documented station pattern):
#   DATABASE_URL="file:/ABSOLUTE/PATH/TO/YOU/apps/web/db/custom.db"
#
# The relative form below is kept for the documented local-dev flow run from
# apps/web/ itself (bun install && cp .env.example .env && bun run db:push).
DATABASE_URL="file:../db/custom.db"

# HMAC secret for the local object-store adapter's signed URLs.
# Generate a real one for anything beyond local development.
YOU_STORAGE_SECRET="dev-change-me"

# Object-store backend (src/lib/you/core/storage.ts seam):
#   "fs" (default) — bytes under apps/web/db/you-objects/ (local dev only;
#                    the FS is NOT writable on serverless — Vercel lambdas
#                    fail with ENOENT mkdir '/var/task/db', verified live
#                    during the F9 checklist 2026-10-01).
#   "db"            — bytes as content-addressed YouObject rows in the app
#                    database (serverless-viable hosted dev-tier stand-in;
#                    works on SQLite locally AND PostgreSQL/Neon hosted).
# The production target remains Cloudflare R2 behind the same seam.
YOU_STORAGE_BACKEND="fs"
