# Local development stand-ins (docs/DEPLOYMENT.md "local" environment).
# SQLite stand-in for Neon PostgreSQL. Prisma resolves file: URLs relative to
# prisma/schema.prisma, so this points at apps/web/db/custom.db.
#
# ─── NESTED-LAYOUT WARNING (F-06, W4.A) ──────────────────────────────────────
# apps/web is NESTED inside the monorepo, and bun / the Prisma CLI resolve
# .env files relative to the CURRENT WORKING DIRECTORY (walking up parent
# directories): an OUTER .env (e.g. a repo-root or station-level one) WINS
# over this file whenever a command is launched from above apps/web/.
# Symptom: prisma/next happily boot against a DIFFERENT (or missing) SQLite
# file than the one you pushed, depending on where you started the command.
# Live example seen in the wild: running `bun run db:push` from a station
# whose outer .env sets DATABASE_URL=file:/station/db/custom.db silently
# targets the station database instead of apps/web/db/custom.db.
#
# Recommended robust form — an ABSOLUTE path, immune to both the cwd and the
# outer-env-wins behavior (ambient env vars exported by the station still
# override .env files by design; that is the documented station pattern):
#   DATABASE_URL="file:/ABSOLUTE/PATH/TO/YOU/apps/web/db/custom.db"
#
# The relative form below is kept for the documented local-dev flow run from
# apps/web/ itself (bun install && cp .env.example .env && bun run db:push).
DATABASE_URL="file:../db/custom.db"

# HMAC secret for the local object-store adapter's signed URLs.
# Generate a real one for anything beyond local development.
YOU_STORAGE_SECRET="dev-change-me"

# Object-store backend (src/lib/you/core/storage.ts seam):
#   "fs" (default) — bytes under apps/web/db/you-objects/ (local dev only;
#                    the FS is NOT writable on serverless — Vercel lambdas
#                    fail with ENOENT mkdir '/var/task/db', verified live
#                    during the F9 checklist 2026-10-01).
#   "db"            — bytes as content-addressed YouObject rows in the app
#                    database (serverless-viable hosted dev-tier stand-in;
#                    works on SQLite locally AND PostgreSQL/Neon hosted).
# The production target remains Cloudflare R2 behind the same seam.
YOU_STORAGE_BACKEND="fs"

# Recon vision provider (P6.C1): local (default — in-sandbox z-ai SDK) or
# openrouter (hosted vision, production — vlm-recon-or-1)
# YOU_RECON_PROVIDER="local"
# OPENROUTER_API_KEY=""
# YOU_RECON_MODEL="google/gemini-2.5-flash"
# YOU_RECON_TIMEOUT_MS="30000"
# YOU_RECON_BASE_URL="https://openrouter.ai/api/v1"
# r2 backend (P6.A1 production target) — all four required when backend=r2:
# YOU_R2_ACCOUNT_ID=""
# YOU_R2_ACCESS_KEY_ID=""
# YOU_R2_SECRET_ACCESS_KEY=""
# YOU_R2_BUCKET=""
# YOU_R2_ENDPOINT=""  # optional; default https://<account>.r2.cloudflarestorage.com

# ── Resilience (P6.A6 full) ─────────────────────────────────────────────────
# All optional — the defaults below are the SAFE values (bounded, conservative);
# invalid or non-positive values fall back to them (fail-closed).
# Durable jobs: bounded executor retries (exponential backoff + jitter). A
# job whose RETRYABLE errors exhaust these attempts lands in the terminal
# `dead` state (GET /api/v1/jobs/dead) instead of looping forever. Permanent
# errors (validation/consent/not-found/forbidden) still fail terminal at the
# first attempt, exactly like the pre-P6.A6 behavior.
# YOU_JOB_MAX_ATTEMPTS="3"
# YOU_JOB_RETRY_BASE_DELAY_MS="2000"
# YOU_JOB_RETRY_MAX_DELAY_MS="30000"
# Dead-letter retention: dead jobs older than this (days, after deadAt) are
# pruned lazily when an operator inspects the dead-letter list.
# YOU_DEAD_JOB_RETENTION_DAYS="30"
# Provider calls (zai / openrouter): bounded retries, then the per-provider
# circuit breaker. A 429/503 Retry-After from the provider is honored.
# YOU_PROVIDER_MAX_ATTEMPTS="3"
# YOU_PROVIDER_RETRY_BASE_DELAY_MS="1000"
# YOU_PROVIDER_RETRY_MAX_DELAY_MS="15000"
# YOU_PROVIDER_BREAKER_FAILURES="5"
# YOU_PROVIDER_BREAKER_WINDOW_MS="60000"
# YOU_PROVIDER_BREAKER_COOLDOWN_MS="30000"
# Per-provider overrides win over the platform defaults above, e.g.:
# YOU_BREAKER_OPENROUTER_FAILURES="3"
# YOU_BREAKER_ZAI_COOLDOWN_MS="60000"
# Outbound webhook deliveries: bounded retries (network errors, 429 and 5xx;
# receiver Retry-After honored; other 4xx are permanent and never retried).
# YOU_WEBHOOK_MAX_ATTEMPTS="5"
# YOU_WEBHOOK_RETRY_BASE_DELAY_MS="1000"
# YOU_WEBHOOK_RETRY_MAX_DELAY_MS="30000"
