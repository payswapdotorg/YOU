// YOU — Human Reality Infrastructure
// Prisma schema (local dev: SQLite stand-in for Neon PostgreSQL per docs/DEPLOYMENT.md)
// JSON-encoded sub-structures are stored as String (SQLite has no list types).
// Contract authority: docs/DATA_MODEL.md + docs/adr/* in payswapdotorg/YOU.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Plane: Control ─────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())

  users          User[]
  applications   Application[]
  apiKeys        ApiKey[]
  twins          Twin[]
  captureSessions CaptureSession[]
  performances   Performance[]
  renderJobs     RenderJob[]
  jobs           Job[]
  events         EventRecord[]
  webhooks       WebhookEndpoint[]
  consentGrants  ConsentGrant[]
  auditEvents    AuditEvent[]
  artifacts      OutputArtifact[]
  solutions      SolutionArtifact[]
  usageRecords   UsageRecord[]
  agentBodies    AgentBody[]
  avatarSessions AgentAvatarSession[]
  verificationSessions VerificationSession[]
  templates      Template[]
  runtimeBodies  AgentRuntimeBody[]
  runtimeSouls   AgentRuntimeSoul[]
  runtimeSessions AgentRuntimeSession[]
  liveSessions   LiveSession[]
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  email     String   @unique
  name      String
  role      String   @default("owner")
  createdAt DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  sessions Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Application {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  prefix      String
  hash        String    @unique
  scopes      String    @default("[]") // JSON string[]
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ─── Plane: Trust ───────────────────────────────────────────────────────────

model ConsentGrant {
  id         String    @id @default(cuid())
  tenantId   String
  subjectId  String // the human's opaque subject id
  granteeId  String // tenant/app/actor receiving permission
  purpose    String
  scopes     String    @default("[]") // JSON: e.g. ["capture","reconstruct","render","embodiment"]
  operations String    @default("[]") // JSON: allowed operations
  outputs    String    @default("[]") // JSON: allowed output classes (derived only by default)
  // P6.B3 — F1 operator-capture statements (docs/F1_OPERATOR_CAPTURE.md
  // "Required consent"): what is captured / why / which product tests /
  // retention / training (separate, DEFAULT-DENIED) / deletion+withdrawal.
  // "{}" for every pre-B3 grant — the F1 guided flow refuses those with a
  // machine-readable missingStatements list instead of silently passing.
  statements String    @default("{}") // JSON: F1ConsentStatements | {}
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  actorType  String // user | application | system | job
  actorId    String?
  action     String
  entityType String
  entityId   String?
  payload    String   @default("{}") // JSON
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// W2.A (A4) — verification sessions per docs/DATA_MODEL.md "VerificationSession"
// and docs/SECURITY_PRIVACY.md verification semantics:
// - active liveness challenge (control 1);
// - ownership/verification confidence kept SEPARATE from reconstruction
//   fidelity and from visual similarity (controls 2/3);
// - consent-gated at creation (server-enforced, capture scope — see the
//   compatibility note in w2a-report.md: the frozen ConsentScope union has no
//   'verify' member, so the evidence-collection scope is reused);
// - result NEVER claims an identity match (no identity-matching adapter exists);
//   visualSimilarity stays null rather than fabricated.
model VerificationSession {
  id               String    @id @default(cuid())
  tenantId         String
  subjectId        String // the human whose ownership/liveness is being verified (opaque)
  twinId           String? // optional twin this verification attests ownership of
  purpose          String
  method           String    @default("liveness-challenge") // SECURITY_PRIVACY control 1
  status           String    @default("pending") // pending | in_review | evaluated | expired
  challenge        String    @default("{}") // JSON: LivenessChallenge (nonce, prompt, requiredRegions, windows)
  evidenceAssetIds String    @default("[]") // JSON: evidence submitted against the challenge
  result           String? // JSON: VerificationResult (liveness | ownershipConfidence | visualSimilarity=null)
  consentGrantId   String? // covering grant at creation (audit trail)
  expiresAt        DateTime // session expiry (distinct from the challenge window)
  submittedAt      DateTime?
  evaluatedAt      DateTime?
  createdAt        DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ─── Plane: Evidence ────────────────────────────────────────────────────────

model CaptureSession {
  id           String    @id @default(cuid())
  tenantId     String
  twinId       String
  status       String    @default("pending") // pending | uploading | analyzing | complete | failed
  checklist    String    @default("[]") // JSON: [{ item, capability, status, instructions }]
  instructions String? // capture-scientist guidance for this session
  error        String?
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  // ── P6.B3 — F1 operator guided flow (docs/F1_OPERATOR_CAPTURE.md) ──────────
  // Only set on sessions created through POST /twins/:id/capture-sessions/f1;
  // every legacy session keeps the defaults and behaves exactly as before.
  consentGrantId String? // the ACTIVE F1-statement-covered grant (re-verified on every advance; provenance)
  protocol       String? // JSON: F1ProtocolState — the 8 steps, per-step state and the PERSISTED instruction text
  checkpoints    String? // JSON: overall liveness/quality checkpoint summary (per-step reports live in protocol.steps)
  manifest       String? // JSON: content-addressed evidence manifest (built at f1/complete; every asset sha256-verified)
  retention      String? // JSON: effective retention/deletion policy snapshot from the covering consent statements
  review         String  @default("{}") // JSON: F1ReviewState — review verdict + TwinVersion linkage + acceptance chain

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  twin    Twin            @relation(fields: [twinId], references: [id])
  assets  EvidenceAsset[]
  request EvidenceRequest[]
}

model EvidenceAsset {
  id               String   @id @default(cuid())
  tenantId         String
  captureSessionId String
  kind             String // image | video | audio
  storageKey       String // content-addressed object store key (indexed, not unique: same bytes may back multiple logical records)
  contentHash      String // sha256
  bytes            Int
  mime             String
  regions          String   @default("[]") // JSON: captured regions/purposes
  quality          String?  // JSON: analysis result (blur, lighting, coverage…)
  createdAt        DateTime @default(now())

  captureSession CaptureSession @relation(fields: [captureSessionId], references: [id])

  @@index([storageKey])
}

// ─── Plane: Twin ────────────────────────────────────────────────────────────

model Twin {
  id             String   @id @default(cuid())
  tenantId       String
  displayName    String
  personName     String?
  subjectId      String // links to consent subject
  status         String   @default("draft") // draft | capturing | reconstructed | ready
  currentVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  versions        TwinVersion[]
  captureSessions CaptureSession[]
  performances    Performance[]
  renderJobs      RenderJob[]
  avatarSessions  AgentAvatarSession[]
  runtimeSouls    AgentRuntimeSoul[]
  runtimeSessions AgentRuntimeSession[]
  liveSessions    LiveSession[]
}

model TwinVersion {
  id                String   @id @default(cuid())
  twinId            String
  version           Int
  status            String   @default("draft") // draft | published (immutable once published)
  htir              String // JSON: HTIR v1 document (canonical)
  inputVersionIds   String   @default("[]") // JSON: prior versions used as input
  pipelineId        String? // PipelineCandidate id
  evidenceAssetIds  String   @default("[]") // JSON: evidence inputs (content-hashed)
  confidenceSummary String?  // JSON: { overall, byDomain, deficiencies }
  createdAt         DateTime @default(now())

  twin            Twin             @relation(fields: [twinId], references: [id])
  representations  Representation[]
  renderJobs      RenderJob[]
  solutions        SolutionArtifact[]
  feedbacks        FeedbackRequest[]
  evidenceRequests EvidenceRequest[]
  runtimeBodies   AgentRuntimeBody[]

  @@unique([twinId, version])
}

model Representation {
  id            String   @id @default(cuid())
  twinVersionId String
  kind          String // htir-summary | portrait-svg | portrait-image | video | neural | mesh
  adapterId     String // technology/adapter that produced it
  artifactId    String? // OutputArtifact reference
  params        String   @default("{}") // JSON
  createdAt     DateTime @default(now())

  twinVersion TwinVersion @relation(fields: [twinVersionId], references: [id])
}

// ─── Plane: Performance ─────────────────────────────────────────────────────

model Performance {
  id         String   @id @default(cuid())
  tenantId   String
  twinId     String?
  name       String
  origin     String // text | audio | video | motion | generated | interaction
  durationMs Int?
  tracks     String   @default("[]") // JSON: PerformanceTrack[] (state/expression/speech timelines)
  script     String? // dialog source text when origin=text
  createdAt  DateTime @default(now())

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  twin      Twin?       @relation(fields: [twinId], references: [id])
  renderJobs RenderJob[]
}

// ─── Plane: Render ──────────────────────────────────────────────────────────

// W2.B (persistence half) — templates per docs/DATA_MODEL.md "Template" and
// docs/API_CONTRACTS.md §Templates and scenes: POST /templates,
// GET /templates/:id, POST /templates/:id/analyze. A template packages a
// capture checklist, scene recipes and style presets as a versioned record
// (Worker B's Studio surface describes exactly this shape). `analysis` holds
// the latest template.analyze job output (capability coverage report).
model Template {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  version        Int       @default(1) // versioned record; revisions land with a later wave
  status         String    @default("draft") // draft | published (publish transition is a later-wave route)
  manifest       String    @default("{}") // JSON: TemplateManifest { captureChecklist, stylePresets, notes }
  analysis       String? // JSON: TemplateAnalysis (last analyze job output)
  analyzedAt     DateTime?
  idempotencyKey String?   @unique // §API rules: mutating requests support Idempotency-Key
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  recipes SceneRecipe[]
}

// W2.B — scene recipes per docs/DATA_MODEL.md "SceneRecipe": scene composition
// parameters attached to a template (camera, framing, lighting, environment).
model SceneRecipe {
  id         String   @id @default(cuid())
  templateId String
  name       String
  parameters String   @default("{}") // JSON: scene composition parameters
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id])
}

model RenderJob {
  id            String   @id @default(cuid())
  tenantId      String
  twinId        String
  twinVersionId String
  performanceId String?
  kind          String // image | video
  style         String   @default("photorealistic")
  adapterId     String?
  status        String   @default("queued") // queued | running | succeeded | failed
  artifactId    String?
  costUsd       Float?
  latencyMs     Int?
  error         String?
  createdAt     DateTime @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  twin        Twin         @relation(fields: [twinId], references: [id])
  twinVersion TwinVersion  @relation(fields: [twinVersionId], references: [id])
  performance Performance? @relation(fields: [performanceId], references: [id])
  solutions   SolutionArtifact[]
}

model OutputArtifact {
  id          String   @id @default(cuid())
  tenantId    String
  kind        String // image | video | svg | htir | report | manifest
  storageKey  String // local object store (R2-shaped adapter); indexed, not unique (deterministic adapters may emit identical bytes)
  remoteUrl   String? // provider-hosted reference when bytes not re-hosted
  contentHash String
  bytes       Int
  mime        String
  meta        String   @default("{}") // JSON (provenance, adapter, params)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([storageKey])
}

// ─── Solution Artifacts / feedback loop ─────────────────────────────────────

model SolutionArtifact {
  id            String   @id @default(cuid())
  tenantId      String
  title         String
  type          String // twin-review | render-review | benchmark-report | avatar-session
  manifest      String // JSON: manifest per docs/SOLUTION_ARTIFACT.md
  twinVersionId String?
  renderJobId   String?
  createdAt     DateTime @default(now())

  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  twinVersion TwinVersion?  @relation(fields: [twinVersionId], references: [id])
  renderJob   RenderJob?    @relation(fields: [renderJobId], references: [id])
  feedbacks   FeedbackRequest[]
}

model FeedbackRequest {
  id                 String   @id @default(cuid())
  tenantId           String
  solutionArtifactId String?
  twinVersionId      String
  region             String? // e.g. face.hairline, hands, silhouette
  frame              String?
  verdict            String // correct | incorrect | uncertain | missing-detail | wrong-motion | wrong-identity | wrong-style
  note               String?
  status             String   @default("open") // open | addressed
  createdAt          DateTime @default(now())

  solutionArtifact SolutionArtifact? @relation(fields: [solutionArtifactId], references: [id])
  twinVersion      TwinVersion      @relation(fields: [twinVersionId], references: [id])
}

model EvidenceRequest {
  id               String   @id @default(cuid())
  tenantId         String
  twinVersionId    String?
  captureSessionId String? // linked fulfillment capture (set when a guided fulfillment starts; status flips to fulfilled at complete — P6.B5)
  reason           String
  capability       String // face | hair | hands | silhouette | motion | speech | teeth …
  instructions     String
  expectedSignal   String
  scope            String // privacy/consent scope statement
  status           String   @default("open") // open | fulfilled | expired
  createdAt        DateTime @default(now())

  captureSession CaptureSession? @relation(fields: [captureSessionId], references: [id])
  twinVersion    TwinVersion?    @relation(fields: [twinVersionId], references: [id])
}

// ─── Jobs / events / webhooks (durable async truth, ADR-0005) ──────────────

model Job {
  id             String    @id @default(cuid())
  tenantId       String
  kind           String // capture.quality | twin.compile | render.image | render.video | performance.fromText | lab.benchmark
  status         String    @default("queued") // queued|provisioning|running|collecting|succeeded|failed|cancelled|unavailable|dead (terminal dead-letter after bounded retries, P6.A6-FULL)
  input          String    @default("{}") // JSON
  output         String? // JSON
  progress       Float     @default(0)
  steps          String    @default("[]") // JSON: [{ key, label, status }]
  error          String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model EventRecord {
  id         String   @id @default(cuid())
  tenantId   String
  type       String // twin.created | capture.completed | job.succeeded | render.succeeded | consent.granted …
  entityType String
  entityId   String?
  payload    String   @default("{}") // JSON
  createdAt  DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  deliveries  WebhookDelivery[]
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  secret    String
  events    String   @default("[]") // JSON: subscribed event types
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  endpointId String
  eventId    String
  status     String   @default("pending") // pending | delivered | failed | skipped
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])
  event    EventRecord     @relation(fields: [eventId], references: [id])
}

// ─── Plane: Technology / Lab ────────────────────────────────────────────────

model TechnologyCandidate {
  id             String  @id @default(cuid())
  techId         String  @unique // e.g. "sam2", "smpl-x", "vlm-recon"
  name           String
  family         String // segmentation | body-recon | face | render | llm | …
  vendor         String?
  source         String // open | closed | fixture
  licenseCode    String // code license
  licenseWeights String // model-weight license
  licenseData    String // dataset license
  providerTerms  String
  runtime        String // requirements
  patentNotes    String   @default("")
  status         String // research | candidate | validated | production | retired | closed-characterized
  meta           String   @default("{}") // JSON: notes, links

  versions TechnologyVersion[]
}

model TechnologyVersion {
  id               String   @id @default(cuid())
  candidateId      String
  version          String
  adapterVersion   String
  capabilities     String   @default("[]") // JSON
  inputContract    String   @default("{}")
  outputContract   String   @default("{}")
  resources        String   @default("{}") // JSON: vram, cpu…
  latencyP50Ms     Int?
  costUsdPerUnit   Float?
  failureClasses   String   @default("[]") // JSON
  benchmarkProfile String   @default("{}") // JSON
  provenance       String   @default("{}") // JSON
  createdAt        DateTime @default(now())

  candidate TechnologyCandidate @relation(fields: [candidateId], references: [id])
}

model LabObjective {
  id          String   @id @default(cuid())
  code        String   @unique // HUMAN-RECON-001
  title       String
  description String
  target      String   @default("{}") // JSON: goal spec
  gates       String   @default("{}") // JSON: promotion gates
  status      String   @default("active")
  createdAt   DateTime @default(now())
}

model PipelineCandidate {
  id         String   @id @default(cuid())
  name       String
  genome     String // JSON: PipelineGenome
  generation Int      @default(0)
  parentId   String?
  origin     String // generalist | hand-designed | searched
  status     String   @default("draft") // draft | benchmarked | validated | canary | production | retired
  createdAt  DateTime @default(now())
}

model BenchmarkRun {
  id           String    @id @default(cuid())
  objectiveId  String
  worldSeed    Int
  status       String    @default("queued")
  organizations String   @default("[]") // JSON: org descriptors
  metrics      String? // JSON: aggregate comparison
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime  @default(now())

  reports   EvaluationReport[]
  failures  FailureCase[]
}

model EvaluationReport {
  id             String   @id @default(cuid())
  benchmarkRunId String
  organizationId String
  scores         String   @default("{}") // JSON: metric → value
  reproducible   Boolean  @default(false)
  seed           Int
  detail         String   @default("{}") // JSON: per-stage evidence
  createdAt      DateTime @default(now())

  benchmarkRun BenchmarkRun @relation(fields: [benchmarkRunId], references: [id])
}

model FailureCase {
  id                 String   @id @default(cuid())
  benchmarkRunId     String?
  organizationId     String?
  inputConditions    String   @default("{}") // JSON
  pipeline           String   @default("{}") // JSON
  technologyVersions String   @default("[]") // JSON
  artifacts          String   @default("[]") // JSON refs
  suspectedCause     String
  confidence         Float    @default(0.5)
  remediation        String?
  createdAt          DateTime @default(now())

  benchmarkRun BenchmarkRun? @relation(fields: [benchmarkRunId], references: [id])
}

model PromotionRecord {
  id          String   @id @default(cuid())
  pipelineId  String
  fromStatus  String
  toStatus    String
  decision    String // promoted | rejected | reverted | drafted
  evidence    String   @default("{}") // JSON: benchmark refs, rights/privacy refs
  decidedBy   String   @default("tl")
  createdAt   DateTime @default(now())
}

// ─── Plane: Agent embodiment ────────────────────────────────────────────────

model AgentBody {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  role        String
  version     Int      @default(1)
  capabilities String  @default("[]") // JSON
  tools       String   @default("[]") // JSON
  permissions String   @default("[]") // JSON
  memory      String   @default("{}") // JSON: memory policy + working notes
  evaluation  String   @default("{}") // JSON: evaluator spec
  createdAt   DateTime @default(now())

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  possessions AgentSoulBinding[]
  sessions  AgentAvatarSession[]
}

model AgentSoulBinding {
  id           String   @id @default(cuid())
  bodyId       String
  soulKey      String // catalog key e.g. "soul-one-fast"
  provider     String // zai | openai | … (adapter)
  model        String
  routingClass String // system_one | system_two
  params       String   @default("{}") // JSON: thinking, temperature…
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  body AgentBody @relation(fields: [bodyId], references: [id])
}

model AgentAvatarSession {
  id        String    @id @default(cuid())
  tenantId  String
  bodyId    String
  soulKey   String
  twinId    String?
  status    String    @default("live") // live | ended
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  tenant Tenant            @relation(fields: [tenantId], references: [id])
  body   AgentBody         @relation(fields: [bodyId], references: [id])
  twin   Twin?             @relation(fields: [twinId], references: [id])
  turns  AgentAvatarTurn[]
}

model AgentAvatarTurn {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user | agent
  content   String
  states    String   @default("[]") // JSON: AgentPerformanceEvent[] emitted for this turn
  latencyMs Int?
  createdAt DateTime @default(now())

  session AgentAvatarSession @relation(fields: [sessionId], references: [id])
}

// ─── Agent Body/Soul production runtime (P6.C6) ─────────────────────────────
// Bodies: visual/physical avatar assets bound to a TwinVersion (+ the ADR-0002
// role/tool contract). Souls: personality/behavior configuration bound to a
// Twin. Lifecycle: draft → active ⇄ inactive; definition edits append an
// IMMUTABLE version snapshot (AgentRuntime*Version) so sessions stay pinned
// to the exact definitions they bound (reproducibility law). The legacy
// AgentBody/AgentSoulBinding/AgentAvatarSession models above are untouched
// (frozen surface); this is the separate production runtime.

model AgentRuntimeBody {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  role          String
  description   String?
  twinVersionId String? // visual/physical avatar assets binding (null = abstract body)
  version       Int      @default(1)
  status        String   @default("draft") // draft | active | inactive
  tools         String   @default("[]") // JSON: tool allow-list (W2.C registry names)
  manifest      String   @default("{}") // JSON: honest capability manifest { can, cannot }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant                     @relation(fields: [tenantId], references: [id])
  twinVersion TwinVersion?               @relation(fields: [twinVersionId], references: [id])
  versions    AgentRuntimeBodyVersion[]
  sessions    AgentRuntimeSession[]
}

model AgentRuntimeBodyVersion {
  id        String   @id @default(cuid())
  bodyId    String
  version   Int
  snapshot  String // JSON: immutable definition { name, role, description, twinVersionId, tools, manifest }
  createdAt DateTime @default(now())

  body AgentRuntimeBody @relation(fields: [bodyId], references: [id], onDelete: Cascade)

  @@unique([bodyId, version])
}

model AgentRuntimeSoul {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  twinId      String // a Soul is personality/behavior configuration bound to a Twin
  persona     String   @default("{}") // JSON: { tagline, traits, speakingStyle, additionalInstructions }
  provider    String   @default("zai") // chat adapter id (wave-1: zai seam only)
  model       String // declared model binding (recorded provenance)
  params      String   @default("{}") // JSON: { thinking?, temperature? } — behavior configuration
  seed        Int // determinism base seed (immutable after create; recorded on sessions/turns)
  version     Int      @default(1)
  status      String   @default("draft") // draft | active | inactive
  manifest    String   @default("{}") // JSON: honest capability manifest { can, cannot }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant                    @relation(fields: [tenantId], references: [id])
  twin     Twin                      @relation(fields: [twinId], references: [id])
  versions AgentRuntimeSoulVersion[]
  sessions AgentRuntimeSession[]
}

model AgentRuntimeSoulVersion {
  id        String   @id @default(cuid())
  soulId    String
  version   Int
  snapshot  String // JSON: immutable definition { name, description, twinId, persona, provider, model, params, manifest, seed }
  createdAt DateTime @default(now())

  soul AgentRuntimeSoul @relation(fields: [soulId], references: [id], onDelete: Cascade)

  @@unique([soulId, version])
}

model AgentRuntimeSession {
  id             String    @id @default(cuid())
  tenantId       String
  twinId         String // session binds (Twin, Body, Soul) — twin derived from the Soul, validated against the Body
  bodyId         String
  bodyVersion    Int // pinned Body definition version at bind time
  soulId         String
  soulVersion    Int // pinned Soul definition version at bind time
  consentGrantId String? // consent provenance: the embodiment grant covering the bind (re-verified per turn)
  seed           Int // session base seed (turn seeds derive deterministically)
  status         String    @default("live") // live | ended
  createdAt      DateTime  @default(now())
  endedAt        DateTime?

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  twin   Twin               @relation(fields: [twinId], references: [id])
  body   AgentRuntimeBody   @relation(fields: [bodyId], references: [id])
  soul   AgentRuntimeSoul   @relation(fields: [soulId], references: [id])
  turns  AgentRuntimeTurn[]
  liveSessions LiveSession[]
}

model AgentRuntimeTurn {
  id        String   @id @default(cuid())
  sessionId String
  role      String // user | agent
  content   String
  seed      Int? // recorded per turn — the seed that parameterized the agent turn's request
  model     String? // model binding recorded on agent turns (provenance)
  states    String   @default("[]") // JSON: AgentPerformanceEvent[] emitted for this turn
  latencyMs Int?
  jobId     String? // the durable agent.turn job driving this exchange (user turns)
  createdAt DateTime @default(now())

  session AgentRuntimeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ─── Live sessions (P6.C7 — realtime performance / WebRTC path) ────────────
// A LiveSession is the LOW-LATENCY realtime surface, kept fully SEPARATE from
// the offline rendering loop (twins/captures/performances/renders/artifacts
// never touch this table). It binds optionally to a Twin and optionally to a
// C6 AgentRuntimeSession; consent is REQUIRED (consentGrantId is non-null — a
// live session cannot open without a grant covering live performance, which
// is the embodiment scope: driving a twin's live performance IS realtime
// embodiment; the frozen ConsentScope union is deliberately not widened).
// status: connecting (offer/answer exchange in progress) | live (peer
// connected) | ended (explicit teardown, idempotent) | failed (honest
// connection failure). signaling holds the RELAYED WebRTC signaling state +
// the bounded live state-event stream as JSON (see lib/you/live/live-core.ts).
model LiveSession {
  id              String    @id @default(cuid())
  tenantId        String
  twinId          String? // optional twin binding (human-driven live performance)
  agentSessionId  String? // optional binding to a C6 agent session (agent-driven live state)
  consentGrantId  String // REQUIRED — the grant covering live performance (provenance, re-checked on state writes)
  status          String    @default("connecting") // connecting | live | ended | failed
  signaling       String    @default("{}") // JSON: LiveSignalingState (phase, offer/answer/candidates, state events)
  createdAt       DateTime  @default(now())
  endedAt         DateTime?

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  twin         Twin?                 @relation(fields: [twinId], references: [id])
  agentSession AgentRuntimeSession?  @relation(fields: [agentSessionId], references: [id])
}

// ─── Usage metering ─────────────────────────────────────────────────────────

model UsageRecord {
  id        String   @id @default(cuid())
  tenantId  String
  metric    String // evidence.bytes | job.reconstruction | job.render.image | llm.tokens …
  quantity  Float
  meta      String   @default("{}") // JSON
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// ─── Object storage (db backend) ────────────────────────────────────────────
// F9 finding (2026-10-01 station verification): the local-FS object store
// (db/you-objects/) cannot write on Vercel serverless — the lambda bundle
// root is read-only (live evidence: ENOENT mkdir '/var/task/db' on the
// hosted upload path). YOU_STORAGE_BACKEND=db stores the same
// content-addressed immutable objects as rows here, behind the unchanged
// putObject/getObject seam + signed-URL capability model in
// src/lib/you/core/storage.ts. Production target remains Cloudflare R2
// (docs/DEPLOYMENT.md) — this is the hosted dev-tier stand-in, exactly like
// SQLite stands in for Neon locally. Bytes maps to BLOB (sqlite) / bytea
// (postgresql) — verified on both providers.
model YouObject {
  key       String   @id // content-addressed storage key: kind/<sha256>.<ext>
  mime      String
  bytes     Bytes
  createdAt DateTime @default(now())
}
